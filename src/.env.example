# Copy this file to .env for local development (python-dotenv loads it
# automatically on `python app.py`). Local runs still need
# `databricks auth login` configured, so the Databricks SDK's
# WorkspaceClient can fetch the Lakebase secret below - there is no
# separate local-only connection path; see setup_secrets.py.

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=ticketing-lakebase-url

# Optional, for local Flask runs only:
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
